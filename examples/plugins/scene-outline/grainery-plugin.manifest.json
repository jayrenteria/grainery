{
  "schemaVersion": 1,
  "id": "com.grainery.scene-outline",
  "name": "Scene Manager",
  "version": "1.3.1",
  "description": "Numbers scenes and adds an always-visible scene map with jump navigation.",
  "engine": {
    "grainery": ">=1.6.2",
    "pluginApi": "^1.2.0"
  },
  "entry": "dist/main.js",
  "permissions": [
    "document:read",
    "document:write"
  ],
  "optionalPermissions": [
    "ui:mount"
  ],
  "networkAllowlist": [],
  "permissionRationales": {
    "ui:mount": "Shows the scene map, scene numbers, and Scene Manager panel."
  },
  "activationEvents": [
    "onStartup",
    "onUIControl:toggle-scene-outline",
    "onUIPanel:scene-outline-panel",
    "onTransform:post-open",
    "onTransform:pre-save",
    "onTransform:pre-export"
  ],
  "contributes": {
    "commands": [],
    "menus": [],
    "keybindings": [],
    "exporters": [],
    "importers": [],
    "statusBadges": [],
    "inlineAnnotationProviders": [],
    "editorCompletionProviders": [],
    "editorLandmarkProviders": [
      {
        "id": "scene-landmarks",
        "title": "Scene map and numbers",
        "priority": 100
      }
    ],
    "uiControls": [
      {
        "id": "toggle-scene-outline",
        "mount": "bottom-bar",
        "kind": "button",
        "label": "Scenes",
        "icon": "scene-heading",
        "priority": 5,
        "tooltip": "Open scene outline panel",
        "action": {
          "type": "panel:toggle",
          "panelId": "scene-outline-panel"
        },
        "when": "plugin.enabled"
      }
    ],
    "uiPanels": [
      {
        "id": "scene-outline-panel",
        "title": "Scene Manager",
        "icon": "scene-heading",
        "defaultWidth": 320,
        "minWidth": 260,
        "maxWidth": 420,
        "priority": 5,
        "when": "plugin.enabled"
      }
    ],
    "transforms": [
      {
        "id": "renumber-scenes-post-open",
        "hook": "post-open",
        "priority": 100
      },
      {
        "id": "renumber-scenes-pre-save",
        "hook": "pre-save",
        "priority": 100
      },
      {
        "id": "renumber-scenes-pre-export",
        "hook": "pre-export",
        "priority": 100
      }
    ]
  }
}
